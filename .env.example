# ==============================================================================
# Agentic AI Research & Security Analysis Platform - Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "gemini", "openai", "groq", "ollama", "mock" (offline fallback)
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:20128/v1
LLM_MODEL=auto/fast
OPENAI_API_KEY=your_openai_or_omniroute_key_here

# Primary API Key (Can be Gemini API Key, OpenAI API Key, or Groq API Key)
LLM_API_KEY=

# Specific Provider Keys (Optional overrides)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Model Selection
# Default models:
# Gemini: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
# OpenAI: gpt-4o-mini, gpt-4o
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# Ollama: llama3, mistral
LLM_MODEL=gemini-1.5-flash

# Web Search Provider Configuration
# Supported: "duckduckgo", "tavily", "mock"
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Storage Paths
DATA_DIR=backend/data
UPLOAD_DIR=backend/data/uploads
DB_PATH=backend/data/platform.db
